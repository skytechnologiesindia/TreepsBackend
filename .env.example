# Treeps backend environment variables.
# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection string used by the app and by Prisma.
# Format: postgresql://<user>:<password>@<host>:<port>/<database>?schema=public
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/treeps_db?schema=public"

# Runtime mode. Required: development, test or production. There is no default; the server refuses to start without it.
NODE_ENV=development

# Port the HTTP server listens on. Optional; plain digits from 1 to 65535 (no leading zero); defaults to 3000.
# PORT=3000

# One-time-password provider. Required: twofactor or fake. There is no default.
# "fake" accepts one known code, so it needs ALLOW_FAKE_OTP=true as well, and the server refuses to start with it when NODE_ENV=production.
OTP_PROVIDER=twofactor

# Required only when OTP_PROVIDER=twofactor. Non-empty, no spaces around it. Placeholder: put your own key in .env.
TWOFACTOR_API_KEY=replace-with-your-2factor-api-key

# Only used when OTP_PROVIDER=twofactor. Optional. Name of the SMS template from your 2Factor dashboard; letters, digits, "_" and "-"; defaults to OTP1.
# TWOFACTOR_TEMPLATE=OTP1

# Only for OTP_PROVIDER=fake (local development and tests). Never set these in a deployed environment.
# ALLOW_FAKE_OTP=true
# FAKE_OTP_CODE=123456

# Number of proxies in front of the server whose forwarded-for header is trusted. Optional; whole number 0 to 10; defaults to 0 (untrusted: the connection's own address is used).
# TRUST_PROXY_HOPS=0

# Version label of the terms of use, stored with the time a rider completes the profile. Optional; letters, digits, . _ - up to 32 characters; defaults to 2026-10-v1.
# TERMS_VERSION=2026-10-v1

# Where uploaded driver photos are kept. Optional in development (defaults to local = a folder named storage/ next to the app);
# REQUIRED in production, where it must be s3 (the server refuses to start with local when NODE_ENV=production).
# STORAGE_DRIVER=local

# Only when STORAGE_DRIVER=s3. The bucket must be PRIVATE (all public access blocked). Bucket: 3 to 63 characters, lower case letters, digits, dots, hyphens.
# S3_BUCKET=treeps-driver-documents
# Region of the bucket, for example ap-south-1 (Mumbai). Cloudflare R2 uses auto.
# S3_REGION=ap-south-1
# Optional. Only for an S3-compatible service other than AWS (for example Cloudflare R2). An https address.
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# The keys are NOT our settings: the AWS client reads AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY from the environment (or the server's role).
# Give that key permission for this one bucket only (s3:PutObject, s3:GetObject, s3:DeleteObject, s3:ListBucket). Never commit them.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

