# Treeps backend environment variables.
# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection string used by the app and by Prisma.
# Format: postgresql://<user>:<password>@<host>:<port>/<database>?schema=public
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/treeps_db?schema=public"

# Runtime mode. Required: development, test or production. There is no default; the server refuses to start without it.
NODE_ENV=development

# Port the HTTP server listens on. Optional; plain digits from 1 to 65535 (no leading zero); defaults to 3000.
# PORT=3000
