// Driver identity, login and the onboarding profile (set by POST /v1/driver/onboarding, all nullable
// until then). The documents live in DriverDocument. Vehicle and recharge come in later steps. No
// live-location or online state lives here. The Aadhaar number a driver types is stored in
// DriverDocument.number (decision 187, which reverses decision 152; legal check: TO DECIDE).
enum DriverStatus {
  DOCUMENTS_PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
  BLOCKED
  DELETED
}

model Driver {
  id              String       @id @default(uuid())
  phoneNumber     String       @unique
  status          DriverStatus @default(DOCUMENTS_PENDING)
  isPhoneVerified Boolean      @default(false) // The server sets true after the OTP check
  lastLoginAt     DateTime?    @db.Timestamptz(3)
  deletedAt       DateTime?    @db.Timestamptz(3)
  createdAt       DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @db.Timestamptz(3)

  // Onboarding profile (the PERSONAL_INFO step). Null until the driver submits.
  fullName         String?   @db.VarChar(100)
  dateOfBirth      DateTime? @db.Date
  gender           Gender?
  profilePhotoPath String? // The storage path of the profile photo, never a URL
  submittedAt      DateTime? @db.Timestamptz(3) // When the application was last submitted

  devices   DriverDevice[]
  documents DriverDocument[]
}

// One row per driver install. Mirrors Device; separate tables so no foreign key is shared and nullable.
model DriverDevice {
  id            String               @id @default(uuid())
  driverId      String
  driver        Driver               @relation(fields: [driverId], references: [id], onDelete: Cascade)
  deviceId      String // The app's install id; id above is the server's uuid
  platform      DevicePlatform
  appVersion    String
  fcmToken      String?
  lastSeenAt    DateTime             @db.Timestamptz(3)
  refreshTokens DriverRefreshToken[]

  @@unique([driverId, deviceId])
}

// Mirrors RefreshToken. Revoked rows are kept: presenting a rotated token again is how reuse is detected.
model DriverRefreshToken {
  id        String       @id @default(uuid())
  tokenHash String       @unique // SHA-256 of the token; the token itself is never stored
  driverId  String
  deviceId  String
  device    DriverDevice @relation(fields: [driverId, deviceId], references: [driverId, deviceId], onDelete: Cascade)
  expiresAt DateTime     @db.Timestamptz(3)
  revokedAt DateTime?    @db.Timestamptz(3)
  createdAt DateTime     @default(now()) @db.Timestamptz(3)

  @@index([driverId, deviceId])
}
