enum RiderStatus {
  PROFILE_PENDING // Created by verify-otp; the profile is not filled in yet
  ACTIVE
  SUSPENDED
  BLOCKED
  DELETED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

model Rider {
  id                String      @id @default(uuid())
  phoneNumber       String      @unique
  fullName          String?     @db.VarChar(100) // Null until the rider completes the profile; replaces firstName + lastName
  email             String?     @unique // Optional at registration
  gender            Gender? // Optional, not collected at registration
  dateOfBirth       DateTime?   @db.Date // Optional, not collected at registration
  profilePicture    String? // Optional, updated later
  registeredCity    String? // Plain text as Google Maps returns it; never blocks registration
  registeredState   String? // Plain text as Google Maps returns it; never blocks registration
  status            RiderStatus @default(ACTIVE)
  isPhoneVerified   Boolean     @default(false) // The server sets true after the OTP check
  isEmailVerified   Boolean     @default(false) // Nothing verifies an email in the MVP
  isProfileComplete Boolean     @default(false)
  lastLoginAt       DateTime?   @db.Timestamptz(3)
  deletedAt         DateTime?   @db.Timestamptz(3)
  createdAt         DateTime    @default(now()) @db.Timestamptz(3) // Member since timestamp
  updatedAt         DateTime    @updatedAt @db.Timestamptz(3)

  // Relations
  devices           Device[]
  savedPlaces       SavedPlace[]
  emergencyContacts EmergencyContact[]

  @@index([status])
  @@index([createdAt])
}

model SavedPlace {
  id        String @id @default(uuid())
  riderId   String
  rider     Rider  @relation(fields: [riderId], references: [id], onDelete: Cascade)
  title     String // e.g., "Home", "Work"
  address   String
  latitude  Float
  longitude Float
}

model EmergencyContact {
  id      String @id @default(uuid())
  riderId String
  rider   Rider  @relation(fields: [riderId], references: [id], onDelete: Cascade)
  name    String
  phone   String
}
